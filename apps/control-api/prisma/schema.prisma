generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Run {
  id String @id @default(uuid())
  requestKey String @unique
  task String
  mode String
  spec Json?
  baselineId String?
  contextMode String @default("full")
  projectId String?
  project Project? @relation(fields: [projectId], references: [id])
  memoryEnabled Boolean @default(false)
  compactRequested Int @default(0)
  status String @default("QUEUED")
  workerId String?
  generation Int @default(0)
  leaseUntil DateTime?
  cancelRequested Boolean @default(false)
  result Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events Event[]
  @@index([status, leaseUntil])
}
model Project {
  id String @id
  owner String @default("local")
  source String
  subdir String
  createdAt DateTime @default(now())
  runs Run[]
  memories Memory[]
}
model Memory {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id])
  scope String @default("project")
  content String
  sourceRun String
  evidenceRefs Json
  baseCommit String
  validity String @default("active")
  version Int @default(1)
  confirmedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([projectId, validity])
}
model IndexHead {
  id String @id
  projectId String
  commit String
  scope String
  embedding String
  pendingId String?
  publishedId String?
  updatedAt DateTime @updatedAt
  @@index([projectId])
}
model IndexBuild {
  id String @id
  headId String
  runId String
  workerId String
  generation Int
  snapshotHash String
  collection String
  pointIds Json
  manifestHash String
  status String @default("BUILDING")
  createdAt DateTime @default(now())
  @@index([headId, status])
}
model Event {
  id Int @id @default(autoincrement())
  runId String
  run Run @relation(fields: [runId], references: [id])
  key String
  type String
  data Json
  createdAt DateTime @default(now())
  @@unique([runId, key])
  @@index([runId, id])
}
model Outbox {
  id Int @id @default(autoincrement())
  runId String
  publishedAt DateTime?
  createdAt DateTime @default(now())
  @@index([publishedAt, id])
}
