# Use scripts/configure.py to generate independent local secrets.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
WORKER_TOKEN=
LIVE_ENABLED=false
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=
# Private hosted demo (infra/compose.hosted.yaml).
# Generate the hash with: docker run --rm -it caddy:2-alpine caddy hash-password
# Put the resulting value in single quotes to preserve its literal dollar signs.
REPOFIX_DOMAIN=
DEMO_USERNAME=demo
DEMO_PASSWORD_HASH=
# free-quota (user's relay allowlist) or official-deepseek (paid official Flash only).
# Official: MODEL_NAME=deepseek-flash, MODEL_BASE_URL=https://api.deepseek.com
# Official requests use non-thinking mode and never retry or fall back to another model.
MODEL_POLICY=free-quota
